{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Bash(pveversion *)",
      "Bash(dpkg --print-architecture)",
      "Bash(pvesm status *)",
      "Bash(pvesh get /cluster/nextid)",
      "Bash(pvesh get /cluster/resources *)",
      "Bash(qm list)",
      "Bash(qm config *)",
      "Bash(qm status *)",
      "Bash(qm listsnapshot *)",
      "Bash(ip -br link *)",
      "Bash(ip -br addr *)",
      "Bash(sha256sum *)",
      "Bash(minisign -Vm *)",
      "Bash(curl -fsSL --proto =https --tlsv1.2 -o /root/agos-proxmox.sh https://github.com/kroqdotdev/agos/releases/download/v0.1.0/agos-proxmox.sh)",
      "Bash(curl -fsSL --proto =https --tlsv1.2 -o /root/agos-SHA256SUMS https://github.com/kroqdotdev/agos/releases/download/v0.1.0/SHA256SUMS)",
      "Bash(curl -fsSL --proto =https --tlsv1.2 -o /root/agos-SHA256SUMS.minisig https://github.com/kroqdotdev/agos/releases/download/v0.1.0/SHA256SUMS.minisig)",
      "Bash(bash /root/agos-proxmox.sh --help)",
      "Bash(bash /root/agos-proxmox.sh --dry-run *)",
      "Bash(bash /root/agos-proxmox.sh status *)",
      "Read(//root/agos-proxmox.sh)",
      "Read(//root/agos-SHA256SUMS)"
    ],
    "ask": [
      "Bash(bash /root/agos-proxmox.sh create *)",
      "Bash(bash /root/agos-proxmox.sh reset *)",
      "Bash(bash /root/agos-proxmox.sh --yes *)",
      "Bash(bash /root/agos-proxmox.sh * --yes *)",
      "Bash(bash /root/agos-proxmox.sh * --yes)",
      "Bash(qm start *)",
      "Bash(qm stop *)",
      "Bash(qm shutdown *)",
      "Bash(qm reboot *)",
      "Bash(qm set *)",
      "Bash(qm snapshot *)",
      "Bash(qm guest *)",
      "Bash(qm agent *)",
      "Bash(apt *)",
      "Bash(apt-get *)"
    ],
    "deny": [
      "Bash(qm destroy *)",
      "Bash(qm rollback *)",
      "Bash(qm delsnapshot *)",
      "Bash(qm disk unlink *)",
      "Bash(qm unlink *)",
      "Bash(pct destroy *)",
      "Bash(pvesm free *)",
      "Bash(pvesm remove *)",
      "Bash(pvesh delete *)",
      "Bash(pve-firewall *)",
      "Bash(bash /root/agos-proxmox.sh destroy *)",
      "Bash(bash /root/agos-proxmox.sh * destroy *)",
      "Bash(bash /root/agos-proxmox.sh * destroy)",
      "Bash(bash)",
      "Bash(sh)",
      "Bash(bash -)",
      "Bash(sh -)",
      "Bash(bash -s *)",
      "Bash(sh -s *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(bash <(*)",
      "Bash(sh <(*)",
      "Bash(sudo *)",
      "Bash(eval *)",
      "Edit(//etc/pve/**)",
      "Edit(//etc/network/**)",
      "Read(//root/agos.secrets)",
      "Edit(//root/agos.secrets)"
    ]
  }
}
