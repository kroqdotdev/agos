#!/usr/bin/env bash
# Fake `curl`: serves https://HOST/PATH from $FAKE_HTTP_ROOT/HOST/PATH.
# Rejects anything that is not https, like --proto '=https' would.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"
record curl "$@"
maybe_fail curl "$@"
out="" url="" head=0 range=""
while (($#)); do
	case $1 in
	-o) out=$2; shift ;;
	--proto | --retry | --retry-delay | --connect-timeout | --max-time) shift ;;
	-r | --range)
		range=$2
		shift
		;;
	-I | -fsSIL | -sSIL) head=1 ;;
	-*) [[ $1 == -*I* && $1 != --* ]] && head=1 ;;
	*) url=$1 ;;
	esac
	shift
done
[[ $url == https://* ]] || {
	echo "curl: (1) Protocol not allowed: $url" >&2
	exit 1
}
src="${FAKE_HTTP_ROOT:?}/${url#https://}"
if [[ ! -f $src ]]; then
	echo "curl: (22) The requested URL returned error: 404" >&2
	exit 22
fi
((head)) && exit 0
if [[ $range == 0-0 ]]; then
	head -c 1 "$src" >"${out:-/dev/stdout}"
	exit 0
fi
if [[ -n $out && $out != /dev/null ]]; then cp "$src" "$out"; else cat "$src"; fi
