#!/usr/bin/env bash
# agos-browser: Chromium the way agents need it (docs/spec.md "Browsers"):
# no first-run/default-browser/keyring/restore prompts, accessibility tree on,
# DevTools on 127.0.0.1:9222 with a dedicated (non-default) profile, which
# Chrome >= 136 requires for CDP.
set -euo pipefail

export DISPLAY="${DISPLAY:-:1}"
profile=/home/agent/.config/agos-chromium
prefs="$profile/Default/Preferences"

# prevents the "Restore pages? Chromium didn't shut down correctly" bubble
# after a crash, kill or VM reset
if [[ -f "$prefs" ]]; then
  sed -i -e 's/"exited_cleanly":false/"exited_cleanly":true/' \
         -e 's/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/' "$prefs" 2>/dev/null || true
fi

exec /usr/bin/chromium \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  --force-renderer-accessibility \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --user-data-dir="$profile" \
  --hide-crash-restore-bubble \
  --noerrdialogs \
  "$@"
