SCHEMA = {
    # dotted key: (kind, extra)
    "hostname": ("hostname", None),
    "display.width": ("int", (320, 8192)),
    "display.height": ("int", (240, 8192)),
    "viewer.listen": ("ip", None),
    "viewer.port": ("int", (1, 65535)),
    "viewer.tls": ("enum", ("auto", "on", "off")),
    "viewer.user": ("user", None),
    "agentd.listen": ("hostport", None),
    "tailscale.enabled": ("enum", ("auto", "true", "false")),
    "tailscale.hostname": ("hostname", None),
    "tailscale.tags": ("tags", None),
    "tailscale.serve": ("bool", None),
    "tailscale.ssh": ("bool", None),
    "agents.claude_code": ("bool", None),
    "agents.t3code": ("bool", None),
}
PASSTHROUGH_TABLES = ("agentd",)


def _check(kind: str, extra, value):
    """Return the normalized value or raise ValueError."""
    if kind == "bool":
        if isinstance(value, bool):
            return value
        raise ValueError("expected true or false")
    if kind == "int":
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError("expected an integer")
        lo, hi = extra
        if not lo <= value <= hi:
            raise ValueError(f"expected {lo}..{hi}")
        return value
    if kind == "enum":
        if isinstance(value, bool):
            value = "on" if value else "off"
            if "true" in extra:
                value = "true" if value == "on" else "false"
        if not isinstance(value, str) or value.lower() not in extra:
            raise ValueError(f"expected one of {', '.join(extra)}")
        return value.lower()
    if kind == "hostname":
        if not isinstance(value, str) or (value and not _HOST_RE.match(value)):
            raise ValueError("expected a hostname label (letters, digits, '-')")
        return value
    if kind == "user":
        if not isinstance(value, str) or not _USER_RE.match(value) or value == KASM_OWNER:
            raise ValueError(f"expected a user name ([A-Za-z0-9._-], not {KASM_OWNER!r})")
        return value
    if kind == "ip":
        if not isinstance(value, str):
            raise ValueError("expected an IP address string")
        ipaddress.ip_address(value)
        return value
    if kind == "hostport":
        if not isinstance(value, str):
            raise ValueError("expected \"host:port\"")
        host, sep, port = value.rpartition(":")
        if not sep or not port.isdigit() or not 0 < int(port) < 65536:
            raise ValueError("expected \"host:port\"")
        ipaddress.ip_address(host.strip("[]") or "127.0.0.1")
        return value
    if kind == "tags":
        if not isinstance(value, list) or not all(
                isinstance(t, str) and re.match(r"^tag:[A-Za-z0-9-]+$", t) for t in value):
            raise ValueError("expected a list like [\"tag:agos\"]")
        return value
    raise AssertionError(kind)


def validate(merged: dict, defaults: dict, run: Run) -> dict:
    cfg = copy.deepcopy(defaults)
    for top, value in merged.items():
        if isinstance(defaults.get(top), dict):
            if not isinstance(value, dict):
                run.error(f"config: [{top}] must be a table; using defaults")
                continue
            for key, sub in value.items():
                dotted = f"{top}.{key}"
                if dotted not in SCHEMA:
                    if top in PASSTHROUGH_TABLES:
                        cfg[top][key] = sub
                    else:
                        run.warn(f"config: unknown key {dotted} ignored")
                    continue
                try:
                    cfg[top][key] = _check(*SCHEMA[dotted], sub)
                except ValueError as exc:
                    run.error(f"config: {dotted} = {sub!r}: {exc}; using {defaults[top][key]!r}")
        elif top in SCHEMA:
            try:
                cfg[top] = _check(*SCHEMA[top], value)
            except ValueError as exc:
                run.error(f"config: {top} = {value!r}: {exc}; using {defaults[top]!r}")
        else:
            run.warn(f"config: unknown key {top} ignored")
    return cfg


def import_agos_fs(run: Run) -> list[str]:
    """Copy config.toml/secrets.env from an AGOS-labelled filesystem (if present)."""
    if not AGOS_LABEL_DEV.exists():
        return []
    copied = []
    mnt = Path(tempfile.mkdtemp(prefix="agos-fs."))
    try:
        res = sh(["mount", "-o", "ro,nosuid,nodev,noexec", str(AGOS_LABEL_DEV), str(mnt)], timeout=30)
        if res.returncode != 0:
            run.error(f"AGOS filesystem: mount failed: {res.stderr.strip()}")
            return []
        try:
            ensure_dir(AGOS_FS_DIR, 0o700, 0, 0)
            for name, mode in (("config.toml", 0o644), ("secrets.env", 0o600)):
                src = mnt / name
                if src.is_file():
                    write_file(AGOS_FS_DIR / name, src.read_bytes(), mode)
                    copied.append(name)
        finally:
            sh(["umount", str(mnt)], timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        run.error(f"AGOS filesystem: {exc}")
    finally:
        try:
            mnt.rmdir()
        except OSError:
            pass
    if copied:
        run.log(f"AGOS filesystem: copied {', '.join(copied)}")
    return copied


def load_config(run: Run) -> tuple[dict, dict, list[str]]:
    defaults = read_toml(DEFAULTS, run, "image defaults")
    import_agos_fs(run)
    layers: list[tuple[str, dict, dict]] = [
        ("agos-fs", read_toml(AGOS_FS_DIR / "config.toml", run, "AGOS config.toml"),
         read_env(AGOS_FS_DIR / "secrets.env")),
        ("etc", read_toml(ETC_CONFIG, run, "/etc/agos/config.toml"), read_env(ETC_SECRETS)),
    ]
    credir = os.environ.get("CREDENTIALS_DIRECTORY")
    cred_cfg: dict = {}
    cred_sec: dict = {}
    if credir:
        try:
            cred_cfg = parse_toml_text((Path(credir) / "agos.config").read_text(), run,
                                       "credential agos.config")
        except OSError:
            pass
        try:
            cred_sec = parse_env((Path(credir) / "agos.secrets").read_text())
        except OSError:
            pass
    layers.append(("credentials", cred_cfg, cred_sec))

    merged: dict = {}
    secrets_: dict[str, str] = {}
    sources = ["defaults"]
    for name, cfg, sec in layers:
        if cfg or sec:
            sources.append(name)
        merged = deep_merge(merged, cfg)
        secrets_.update({k: v for k, v in sec.items() if v != ""})
    for key in secrets_:
        if key not in KNOWN_SECRETS:
            run.warn(f"secrets: unknown key {key} (ignored by agos)")
    return validate(merged, defaults, run), secrets_, sources


# --------------------------------------------------------------------------
# 2./3. secrets and rendering


def gen_password(nbytes: int = 18) -> str:
    return secrets.token_urlsafe(nbytes)


def ensure_secrets(cfg: dict, sec: dict, eff: dict, run: Run) -> None:
    generated: dict[str, str] = {}
    if not sec.get("AGENTD_TOKEN"):
        generated["AGENTD_TOKEN"] = "agd_" + secrets.token_urlsafe(32)
    if eff["viewer_auth"] and not sec.get("VIEWER_PASSWORD"):
        generated["VIEWER_PASSWORD"] = gen_password()
    if generated:
        sec.update(generated)
        update_env_file(ETC_SECRETS, generated, note=f"generated by agos-firstboot {now_iso()}")
        run.log(f"generated {', '.join(sorted(generated))} (stored in {ETC_SECRETS})")
    if ETC_SECRETS.exists():
        # cloud-init or an admin may have written it with looser permissions
        os.chown(ETC_SECRETS, 0, 0)
        os.chmod(ETC_SECRETS, 0o600)


def kasm_hash(password: str) -> str:
    # Same as kasmvncpasswd: SHA-256 crypt with the fixed salt "kasm".
    res = sh(["openssl", "passwd", "-5", "-salt", "kasm", "-stdin"], input=password + "\n",
             timeout=20, check=True)
    return res.stdout.strip()


def ensure_viewer_cert(home: Path, uid: int, gid: int, hostname: str, ips: list[str],
                       run: Run) -> tuple[Path, Path]:
    tls = home / ".config/agos/tls"
    ensure_dir(tls, 0o700, uid, gid)
    crt, key = tls / "viewer.crt", tls / "viewer.key"
    if crt.exists() and key.exists():
        return crt, key
    san = [f"DNS:{hostname}", "DNS:localhost", "IP:127.0.0.1"] + [f"IP:{ip}" for ip in ips]
    try:
        sh(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650",
            "-subj", f"/CN={hostname}", "-addext", "subjectAltName=" + ",".join(san),
            "-keyout", str(key), "-out", str(crt)], timeout=60, check=True)
        os.chown(key, uid, gid)
        os.chmod(key, 0o600)
        os.chown(crt, uid, gid)
        os.chmod(crt, 0o644)
        run.log("generated a self-signed viewer certificate")
    except (OSError, subprocess.SubprocessError) as exc:
        run.error(f"viewer certificate: {exc}")
    return crt, key


def agentd_supported_keys(run: Run) -> set[str] | None:
    """Ask the installed agentd which config keys it accepts (it rejects unknown ones)."""
    if not AGENTD_PY.exists():
        return None
    code = ("import dataclasses, json, agentd.config as c;"
            "print(json.dumps([f.name for f in dataclasses.fields(c.Config)]))")
    try:
        res = sh([str(AGENTD_PY), "-c", code], timeout=30)
        if res.returncode == 0:
            return set(json.loads(res.stdout))
        run.warn(f"agentd: could not list config keys: {res.stderr.strip()[-200:]}")
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        run.warn(f"agentd: could not list config keys: {exc}")
    return None


def render_agent(cfg: dict, sec: dict, eff: dict, run: Run) -> None:
    pw = pwd.getpwnam(AGENT)
    uid, gid, home = pw.pw_uid, pw.pw_gid, Path(pw.pw_dir)
    conf = home / ".config"
    for d, mode in ((conf, 0o755), (conf / "agos", 0o700), (home / ".vnc", 0o700),
                    (conf / "agentd", 0o700), (home / ".local", 0o755),
                    (home / ".local/state", 0o755), (home / ".local/state/agentd", 0o700),
                    (conf / "environment.d", 0o700)):
        ensure_dir(d, mode, uid, gid)

    # Restore pre-seeded dotfiles that went missing (e.g. a recreated home).
    skel = Path("/usr/share/agos/home")
    if skel.is_dir():
        for src in skel.rglob("*"):
            dst = home / src.relative_to(skel)
            if src.is_dir():
                if not dst.exists():
                    ensure_dir(dst, 0o700 if src.name in (".gnupg", ".claude") else 0o755, uid, gid)
            elif not dst.exists():
                write_file(dst, src.read_bytes(), 0o600 if ".gnupg" in dst.parts else 0o644, uid, gid)

    # --- KasmVNC display -------------------------------------------------
    crt, key = ensure_viewer_cert(home, uid, gid, eff["hostname"], eff["ipv4"], run)
    v = cfg["viewer"]
    display_env = {
        "WIDTH": cfg["display"]["width"], "HEIGHT": cfg["display"]["height"], "DEPTH": DEPTH,
        "LISTEN": v["listen"], "PORT": v["port"], "SSL_ONLY": int(eff["tls"]),
        "BASIC_AUTH": int(eff["viewer_auth"]), "FRAME_RATE": FRAME_RATE,
        "CERT": crt, "KEY": key,
    }
    write_file(conf / "agos/display.env",
               "# rendered by agos-firstboot from /etc/agos/config.toml; do not edit\n"
               + "".join(f"{k}={val}\n" for k, val in display_env.items()), 0o644, uid, gid)

    ensure_dir(PRIVATE, 0o700, 0, 0)
    owner_pw = OWNER_SECRET.read_text().strip() if OWNER_SECRET.exists() else ""
    if not owner_pw:
        owner_pw = gen_password(24)
        write_file(OWNER_SECRET, owner_pw + "\n", 0o600)
    # KasmVNC 1.5 permissions: r = see the screen, w = mouse/keyboard,
    # o = owner (may use the HTTP API). Viewers start view-only when agentd
    # arbitrates control (takeover adds w through viewer-perm); without agentd
    # they get control.
    viewer_perm = "r" if (eff["viewer_auth"] and eff["agentd_installed"]) else "rw"
    viewer_pw = sec.get("VIEWER_PASSWORD") or gen_password()
    kasmpasswd = (f"{v['user']}:{kasm_hash(viewer_pw)}:{viewer_perm}\n"
                  f"{KASM_OWNER}:{kasm_hash(owner_pw)}:rwo\n")
    write_file(home / ".kasmpasswd", kasmpasswd, 0o600, uid, gid)
    api_host = "127.0.0.1" if v["listen"] in ("0.0.0.0", "::") or is_loopback(v["listen"]) else v["listen"]
    if ":" in api_host:
        api_host = f"[{api_host}]"
    api = {"url": f"{'https' if eff['tls'] else 'http'}://{api_host}:{v['port']}",
           "owner": KASM_OWNER, "password": owner_pw, "viewer": v["user"],
           "basic_auth": eff["viewer_auth"], "initial": "view" if viewer_perm == "r" else "control"}
    write_file(conf / "agos/kasmvnc-api.json", json.dumps(api, indent=2) + "\n", 0o600, uid, gid)

    render_agentd_config(cfg, eff, run)

    tokens_path = conf / "agentd/tokens.toml"
    existing = read_toml(tokens_path, run, "agentd tokens.toml").get("token", [])
    digest = hashlib.sha256(sec["AGENTD_TOKEN"].encode()).hexdigest()
    created = now_iso()
    kept = []
    for entry in existing if isinstance(existing, list) else []:
        if not isinstance(entry, dict):
            continue
        if entry.get("name") == AGENTD_TOKEN_NAME:
            if entry.get("sha256") == digest and entry.get("created"):
                created = str(entry["created"])
            continue
        kept.append(entry)
    tokens = [{"name": AGENTD_TOKEN_NAME, "sha256": digest, "scopes": ["admin"], "created": created}] + kept
    write_file(tokens_path, toml_dumps({"token": tokens},
               "# agentd bearer tokens (sha256 of the token). agos-admin = AGENTD_TOKEN from /etc/agos/secrets.env"),
               0o600, uid, gid)

    # --- user environment -------------------------------------------------
    env_lines = []
    for name in AGENT_ENV_SECRETS:
        val = sec.get(name)
        if not val:
            continue
        if _SAFE_VALUE_RE.match(val):
            env_lines.append(f"{name}={val}")
        elif "'" not in val and "\n" not in val and "$" not in val:
            env_lines.append(f"{name}='{val}'")
        else:
            run.error(f"secrets: {name} contains characters that cannot be exported safely; skipped")
    env_file = conf / "environment.d/50-agos-secrets.conf"
    if env_lines:
        write_file(env_file, "# rendered by agos-firstboot from /etc/agos/secrets.env\n"
                   + "\n".join(env_lines) + "\n", 0o600, uid, gid)
    else:
        env_file.unlink(missing_ok=True)

    # --- Claude Code --------------------------------------------------------
    if cfg["agents"]["claude_code"]:
        preseed_claude(home, uid, gid, sec, eff, run)

    # --- T3 Code ------------------------------------------------------------
    if cfg["agents"]["t3code"] and T3CODE_BIN.exists():
        preseed_t3code(home, uid, gid, run)


def render_agentd_config(cfg: dict, eff: dict, run: Run) -> None:
    """~agent/.config/agentd/config.toml; only keys the installed agentd accepts."""
    pw = pwd.getpwnam(AGENT)
    uid, gid, home = pw.pw_uid, pw.pw_gid, Path(pw.pw_dir)
    agentd_cfg = {
        "display": ":1",
        "listen": cfg["agentd"]["listen"],
        "socket": f"/run/user/{uid}/agentd.sock",
        "audit_log": str(home / ".local/state/agentd/audit.jsonl"),
        "max_image_long_edge": 2576,
        "max_image_pixels": 3750000,
        "default_format": "png",
        "settle_ms": 300,
        "settle_timeout_ms": 3000,
        "on_takeover": ["/usr/lib/agos/viewer-perm", "control"],
        "on_handback": ["/usr/lib/agos/viewer-perm", "view"],
        # link shown in agentd's /ui: the tailnet URL when published, else direct
        "viewer_url": eff.get("public_viewer_url") or eff["viewer_url"],
        # in-VM `agentd mcp` (Claude Code's "desktop" server) goes through the
        # running server, so it cannot bypass a human takeover
        "mcp_mode": "remote",
    }
    for key_, val in cfg["agentd"].items():
        if key_ != "listen":
            agentd_cfg[key_] = val
    supported = agentd_supported_keys(run)
    if supported is not None:
        dropped = sorted(k for k in agentd_cfg if k not in supported)
        if dropped:
            run.warn(f"agentd: installed version does not know {', '.join(dropped)}; not rendered")
        agentd_cfg = {k: val for k, val in agentd_cfg.items() if k in supported}
    try:
        write_file(home / ".config/agentd/config.toml",
                   toml_dumps(agentd_cfg, "# rendered by agos-firstboot; edit /etc/agos/config.toml [agentd]"),
                   0o600, uid, gid)
    except TypeError as exc:
        run.error(f"agentd: cannot render config: {exc}")


def preseed_claude(home: Path, uid: int, gid: int, sec: dict, eff: dict, run: Run) -> None:
    """Merge (never replace) the keys that keep Claude Code from prompting."""
    ensure_dir(home / ".claude", 0o700, uid, gid)
    settings_path = home / ".claude/settings.json"
    settings = read_json(settings_path)
    perms = settings.get("permissions") if isinstance(settings.get("permissions"), dict) else {}
    # prevents per-tool permission prompts (VM-contained agent)
    perms["defaultMode"] = "bypassPermissions"
    settings["permissions"] = perms
    # prevents the one-time bypass-mode warning dialog
    settings["skipDangerousModePermissionPrompt"] = True
    # prevents the first-run theme picker
    settings.setdefault("theme", "dark")
    write_file(settings_path, json.dumps(settings, indent=2) + "\n", 0o600, uid, gid)

    state_path = home / ".claude.json"
    state = read_json(state_path)
    # prevents the onboarding flow (undocumented key, anthropics/claude-code#46259)
    state["hasCompletedOnboarding"] = True
    projects = state.get("projects") if isinstance(state.get("projects"), dict) else {}
    for proj in (str(home), str(home / "work")):
        entry = projects.get(proj) if isinstance(projects.get(proj), dict) else {}
        # prevents the "Do you trust the files in this folder?" dialog
        entry["hasTrustDialogAccepted"] = True
        projects[proj] = entry
    state["projects"] = projects
    servers = state.get("mcpServers") if isinstance(state.get("mcpServers"), dict) else {}
    if eff["agentd_installed"]:
        servers["desktop"] = {"type": "stdio", "command": str(AGENTD_BIN), "args": ["mcp"], "env": {}}
    else:
        servers.pop("desktop", None)
    state["mcpServers"] = servers
    key = sec.get("ANTHROPIC_API_KEY", "")
    if key:
        # prevents "Do you want to use this API key?" (Claude Code stores the last 20 chars)
        resp = state.get("customApiKeyResponses") if isinstance(state.get("customApiKeyResponses"), dict) else {}
        approved = [a for a in resp.get("approved", []) if isinstance(a, str)]
        if key[-20:] not in approved:
            approved.append(key[-20:])
        resp["approved"] = approved
        resp["rejected"] = [r for r in resp.get("rejected", []) if r != key[-20:]]
        state["customApiKeyResponses"] = resp
    write_file(state_path, json.dumps(state, indent=2) + "\n", 0o600, uid, gid)


def preseed_t3code(home: Path, uid: int, gid: int, run: Run) -> None:
    """Merge (never replace) the T3 Code settings that keep it from prompting."""
    data = home / ".t3/userdata"
    ensure_dir(home / ".t3", 0o700, uid, gid)
    ensure_dir(data, 0o700, uid, gid)
    path = data / "client-settings.json"
    settings = read_json(path)
    if path.exists() and not settings:
        run.warn(f"T3 Code: {path} is not a JSON object; left alone")
        return
    if not settings.get("onboardingCompletedAt"):
        # prevents the first-run welcome wizard (connect computers, check
        # agents, import projects); T3 Connect sign-in stays in Settings
        settings["onboardingCompletedAt"] = now_iso()
        write_file(path, json.dumps(settings, indent=2) + "\n", 0o644, uid, gid)
    path = data / "settings.json"
    settings = read_json(path)
    if path.exists() and not settings:
        run.warn(f"T3 Code: {path} is not a JSON object; left alone")
        return
    if "enableProviderUpdateChecks" not in settings:
        # prevents "Update Available: Claude" notices: Claude Code comes from
        # apt (unattended-upgrades), which T3 Code's "Update now" cannot drive
        settings["enableProviderUpdateChecks"] = False
        write_file(path, json.dumps(settings, indent=2) + "\n", 0o644, uid, gid)


def apply_t3code(cfg: dict, run: Run) -> dict:
    """Enable or disable the T3 Code user unit from [agents] t3code."""
    installed = T3CODE_BIN.exists()
    enabled = bool(cfg["agents"]["t3code"]) and installed
    info = {"enabled": enabled, "installed": installed, "version": build_info().get("t3code"),
            "workspace": T3CODE_WORKSPACE if enabled else None}
    if not installed and cfg["agents"]["t3code"]:
        run.log("T3 Code: enabled in the config but not installed in this image")
    # --global edits /etc/systemd/user, which the agent's user manager reads
    # when it starts (this unit runs before user@1000.service; `agos apply`
    # reloads it). The unit has ConditionPathExists, so disabling a missing
    # app is cosmetic.
    is_on = sh(["systemctl", "--global", "is-enabled", "--quiet", T3CODE_UNIT], timeout=30).returncode == 0
    if enabled != is_on:
        res = sh(["systemctl", "--global", "enable" if enabled else "disable", T3CODE_UNIT], timeout=30)
        if res.returncode != 0:
            run.error(f"T3 Code: systemctl --global {'enable' if enabled else 'disable'} failed: "
                      f"{res.stderr.strip()[-200:]}")
        else:
            run.log(f"T3 Code: {'enabled' if enabled else 'disabled'}")
    return info


