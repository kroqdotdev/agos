_USER_RE = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
_ENV_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
_SAFE_VALUE_RE = re.compile(r"^[A-Za-z0-9._~+/=:@%,-]*$")


