def apply_hostname(cfg: dict, run: Run) -> str:
    current = socket.gethostname()
    want = cfg.get("hostname") or ""
    if not want or want == current:
        return current
    mark = HOSTNAME_MARK.read_text().strip() if HOSTNAME_MARK.exists() else None
    if current not in IMAGE_HOSTNAMES and current != mark:
        run.log(f"hostname {current!r} was set by cloud-init or an admin; config hostname {want!r} not applied")
        return current
    res = sh(["hostnamectl", "set-hostname", want], timeout=30)
    if res.returncode != 0:
        write_file(Path("/etc/hostname"), want + "\n")
        sh(["hostname", want], timeout=10)
    try:
        hosts = Path("/etc/hosts").read_text().splitlines()
        hosts = [h for h in hosts if not h.startswith("127.0.1.1")]
        hosts.insert(1 if hosts else 0, f"127.0.1.1\t{want}")
        write_file(Path("/etc/hosts"), "\n".join(hosts) + "\n")
    except OSError as exc:
        run.warn(f"/etc/hosts: {exc}")
    write_file(HOSTNAME_MARK, want + "\n")
    run.log(f"hostname set to {want}")
    return want


def tailscale_status() -> dict:
    try:
        res = sh(["tailscale", "status", "--json"], timeout=15)
        return json.loads(res.stdout) if res.stdout.strip().startswith("{") else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def setup_tailscale(cfg: dict, sec: dict, eff: dict, run: Run) -> dict:
    ts = cfg["tailscale"]
    key = sec.get("TS_AUTHKEY", "")
    mode = ts["enabled"]
    enabled = mode == "true" or (mode == "auto" and bool(key or TS_JOINED.exists()))
    info: dict = {"enabled": enabled, "state": "disabled", "serve": False, "urls": []}
    if not shutil.which("tailscale"):
        if enabled:
            run.error("tailscale: not installed")
        return info
    if not enabled:
        if sh(["systemctl", "is-enabled", "--quiet", "tailscaled.service"], timeout=10).returncode == 0:
            sh(["systemctl", "disable", "--now", "tailscaled.service"], timeout=60)
            run.log("tailscale: disabled")
        return info

    res = sh(["systemctl", "enable", "--now", "tailscaled.service"], timeout=90)
    if res.returncode != 0:
        run.error(f"tailscale: cannot start tailscaled: {res.stderr.strip()}")
        return info
    st: dict = {}
    for _ in range(30):
        st = tailscale_status()
        if st.get("BackendState") not in (None, "", "NoState"):
            break
        time.sleep(0.5)

    ts_host = ts["hostname"] or eff["hostname"]
    if st.get("BackendState") != "Running":
        if not key:
            run.error("tailscale: enabled but not logged in and no TS_AUTHKEY")
            info["state"] = st.get("BackendState", "unknown")
            return info
        authkey = key
        if authkey.startswith("tskey-client-") and "?" not in authkey:
            # OAuth client secret: pre-authorized, non-ephemeral tagged node (spec)
            authkey += "?preauthorized=true&ephemeral=false"
        keyfile = RUN_DIR / "ts-authkey"
        write_file(keyfile, authkey, 0o600)
        cmd = ["tailscale", "up", "--reset", f"--auth-key=file:{keyfile}", f"--hostname={ts_host}",
               f"--ssh={str(ts['ssh']).lower()}", "--timeout=60s"]
        # Plain auth keys join untagged unless tags were configured: forcing a tag
        # fails on any tailnet whose ACL does not grant it. OAuth client secrets
        # can only create tagged nodes, so they get a default tag.
        tags = ts["tags"] or (["tag:agos"] if key.startswith("tskey-client-") else [])
        if tags:
            cmd.append(f"--advertise-tags={','.join(tags)}")
        try:
            res = sh(cmd, timeout=90)
            ok, err = res.returncode == 0, (res.stderr or res.stdout).strip()
        except subprocess.TimeoutExpired:
            ok, err = False, "timed out"
        finally:
            keyfile.unlink(missing_ok=True)
        if not ok:
            run.error(f"tailscale up failed: {err[-300:]}")
            info["state"] = tailscale_status().get("BackendState", "unknown")
            return info
        write_file(TS_JOINED, now_iso() + "\n")
        run.log(f"tailscale: joined as {ts_host}")
        if key.startswith("tskey-auth-"):
            # one-off auth keys are useless after the join; OAuth client secrets are kept
            update_env_file(ETC_SECRETS, remove={"TS_AUTHKEY"})
            if (AGOS_FS_DIR / "secrets.env").exists():
                update_env_file(AGOS_FS_DIR / "secrets.env", remove={"TS_AUTHKEY"})
            run.log("tailscale: removed the used auth key from disk "
                    "(cloud-init keeps its own copy of user-data in /var/lib/cloud)")
    else:
        res = sh(["tailscale", "set", f"--hostname={ts_host}", f"--ssh={str(ts['ssh']).lower()}"], timeout=30)
        if res.returncode != 0:
            run.warn(f"tailscale set: {res.stderr.strip()[-200:]}")

    # tailscale serve: viewer on :443, agentd on its own port. stdin is closed and
    # the call is time-bounded, so a tailnet without HTTPS/Serve enabled cannot
    # leave us waiting at "enable Serve at <url>".
    try:
        sh(["tailscale", "serve", "reset"], timeout=30)
        if ts["serve"]:
            scheme = "https+insecure" if eff["tls"] else "http"
            agentd_port = cfg["agentd"]["listen"].rpartition(":")[2]
            for port, target in (("443", f"{scheme}://127.0.0.1:{cfg['viewer']['port']}"),
                                 (agentd_port, f"http://127.0.0.1:{agentd_port}")):
                res = sh(["tailscale", "serve", "--bg", "--yes", f"--https={port}", target], timeout=45)
                if res.returncode != 0:
                    run.error(f"tailscale serve :{port}: {(res.stderr or res.stdout).strip()[-300:]}")
                    break
            else:
                info["serve"] = True
    except subprocess.TimeoutExpired:
        run.error("tailscale serve timed out (is HTTPS/Serve enabled for the tailnet?)")

    st = tailscale_status()
    info["state"] = st.get("BackendState", "unknown")
    dns = (st.get("Self") or {}).get("DNSName", "").rstrip(".")
    info["dns_name"] = dns
    info["ips"] = (st.get("Self") or {}).get("TailscaleIPs", [])
    if dns and info["serve"]:
        info["urls"] = [f"https://{dns}/", f"https://{dns}:{cfg['agentd']['listen'].rpartition(':')[2]}/"]
    return info


def viewer_url(cfg: dict, eff: dict) -> str:
    v = cfg["viewer"]
    scheme = "https" if eff["tls"] else "http"
    if is_loopback(v["listen"]):
        host = "127.0.0.1"
    elif v["listen"] in ("0.0.0.0", "::"):
        host = (eff["ipv4"] or [eff["hostname"]])[0]
    else:
        host = v["listen"]
    return f"{scheme}://{host}:{v['port']}/"


def render_issue(state: dict) -> None:
    def esc(text: str) -> str:
        return str(text).replace("\\", "\\\\")
    v = state.get("viewer", {})
    ts = state.get("tailscale", {})
    lines = [
        f"agos {esc(state.get('version', '?'))} on \\n - state: {esc(state.get('state', '?'))}",
        "  IPv4:      \\4",
        f"  SSH:       ssh agent@{esc((state.get('ipv4') or ['<ip>'])[0])}",
        f"  Viewer:    {esc(v.get('url', '?'))}"
        + (" (loopback: ssh -L or Tailscale)" if v.get("loopback") else "")
        + (f" user {esc(v.get('user'))}" if v.get("auth") else ""),
    ]
    if ts.get("enabled"):
        urls = ts.get("urls") or []
        lines.append(f"  Tailscale: {esc(ts.get('state', '?'))} {esc(' '.join(urls))}".rstrip())
    lines.append(f"  agentd:    {esc(state.get('agentd', {}).get('listen', '?'))}"
                 + ("" if state.get("agentd", {}).get("installed") else " (not installed)"))
    if state.get("errors"):
        lines.append(f"  Problems:  {len(state['errors'])} - run 'agos status' after logging in")
    write_file(ISSUE, "\n".join(lines) + "\n\n")
    # agetty re-reads issue files on SIGHUP/--reload; harmless if none is running
    sh(["agetty", "--reload"], timeout=5) if shutil.which("agetty") else None


def build_info() -> dict:
    return read_json(BUILD_INFO)


def write_state(state: dict) -> None:
    state["updated"] = now_iso()
    write_file(STATE, json.dumps(state, indent=2, sort_keys=True) + "\n", 0o644)


# --------------------------------------------------------------------------
# main modes


def apply(run: Run) -> int:
    started = time.monotonic()
    first = not DONE.exists()
    for d, mode in ((ETC, 0o755), (STATE_DIR, 0o755), (RUN_DIR, 0o755)):
        ensure_dir(d, mode, 0, 0)
    info = build_info()
    run.log(f"{'first boot' if first else 'apply'} (agos {info.get('version', '?')})")

    if first and not Path("/etc/ssl/private/ssl-cert-snakeoil.key").exists() and shutil.which("make-ssl-cert"):
        # removed from the image so clones never share it; some packages expect it
        sh(["make-ssl-cert", "generate-default-snakeoil", "--force-overwrite"], timeout=60)

    cfg, sec, sources = load_config(run)
    hostname = apply_hostname(cfg, run)
    loop = is_loopback(cfg["viewer"]["listen"])
    ts_cfg = cfg["tailscale"]
    ts_on = ts_cfg["enabled"] == "true" or (
        ts_cfg["enabled"] == "auto" and bool(sec.get("TS_AUTHKEY") or TS_JOINED.exists()))
    eff = {
        "hostname": hostname,
        "ipv4": ipv4_addresses(),
        "tls": cfg["viewer"]["tls"] == "on" or (cfg["viewer"]["tls"] == "auto" and not loop),
        # Basic auth whenever the viewer is reachable from outside the VM:
        # LAN mode, or loopback published on the tailnet by `tailscale serve`.
        "viewer_auth": bool(sec.get("VIEWER_PASSWORD")) or not loop or (ts_on and ts_cfg["serve"]),
        "agentd_installed": AGENTD_BIN.exists(),
    }
    eff["viewer_url"] = viewer_url(cfg, eff)
    ensure_secrets(cfg, sec, eff, run)

    try:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        write_file(RUN_DIR / "config.json", json.dumps(cfg, indent=2, sort_keys=True) + "\n", 0o644)
    except OSError as exc:
        run.error(f"/run/agos/config.json: {exc}")

    try:
        render_agent(cfg, sec, eff, run)
    except (KeyError, OSError, subprocess.SubprocessError) as exc:
        run.error(f"render: {exc!r}")

    t3_info: dict = {"enabled": False}
    try:
        t3_info = apply_t3code(cfg, run)
    except (OSError, subprocess.SubprocessError) as exc:
        run.error(f"T3 Code: {exc!r}")

    ts_info: dict = {"enabled": False}
    try:
        ts_info = setup_tailscale(cfg, sec, eff, run)
    except (OSError, subprocess.SubprocessError) as exc:
        run.error(f"tailscale: {exc!r}")
    if ts_info.get("urls"):
        eff["public_viewer_url"] = ts_info["urls"][0]
        try:
            render_agentd_config(cfg, eff, run)
        except (KeyError, OSError) as exc:
            run.error(f"render agentd: {exc!r}")

    prev = read_json(STATE)
    state = {
        # agos-ready.service turns this into "ready" or "error" once the desktop answers
        "state": "starting",
        "version": info.get("version", ""),
        "arch": info.get("arch", ""),
        "build": info,
        "hostname": hostname,
        "ipv4": eff["ipv4"],
        "first_boot": prev.get("first_boot") or now_iso(),
        "boot_id": Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        "config_sources": sources,
        "display": {"width": cfg["display"]["width"], "height": cfg["display"]["height"], "depth": DEPTH},
        "viewer": {"url": eff["viewer_url"], "listen": cfg["viewer"]["listen"], "port": cfg["viewer"]["port"],
                   "tls": eff["tls"], "auth": eff["viewer_auth"], "user": cfg["viewer"]["user"],
                   "loopback": loop},
        "agentd": {"listen": cfg["agentd"]["listen"], "installed": eff["agentd_installed"]},
        "tailscale": ts_info,
        "agents": {"claude_code": cfg["agents"]["claude_code"] and bool(shutil.which("claude")),
                   "t3code": bool(t3_info.get("enabled"))},
        "t3code": t3_info,
        "errors": run.errors,
        "warnings": run.warnings,
        "firstboot_seconds": round(time.monotonic() - started, 2),
        "firstboot_uptime": round(uptime_s(), 2),
    }
    write_state(state)
    render_issue(state)
    if first:
        write_file(DONE, now_iso() + "\n")
    run.log(f"done in {state['firstboot_seconds']}s, state {state['state']}, "
            f"{len(run.errors)} error(s), {len(run.warnings)} warning(s)")
    return 0


def agent_env() -> tuple[list[str], dict]:
    pw = pwd.getpwnam(AGENT)
    env = {"HOME": pw.pw_dir, "USER": AGENT, "LOGNAME": AGENT, "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
           "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
           "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{pw.pw_uid}/bus",
           "DISPLAY": ":1", "XAUTHORITY": f"{pw.pw_dir}/.Xauthority"}
    return ["/usr/sbin/runuser", "-u", AGENT, "--"], env


def checks(state: dict) -> dict:
    prefix, env = agent_env()
    out: dict[str, bool] = {}
    units = ["agos-display.service", "agos-session.service"]
    if state.get("agentd", {}).get("installed"):
        units.append("agentd.service")
    for unit in units:
        try:
            res = sh(prefix + ["systemctl", "--user", "is-active", "--quiet", unit], timeout=10, env=env)
            out[unit] = res.returncode == 0
        except (OSError, subprocess.SubprocessError):
            out[unit] = False
    try:
        out["x11"] = sh(prefix + ["xdpyinfo", "-display", ":1"], timeout=10, env=env).returncode == 0
        out["xfce4-panel"] = sh(["pgrep", "-u", AGENT, "-x", "xfce4-panel"], timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        out["x11"] = out["xfce4-panel"] = False
    if state.get("agents", {}).get("t3code"):
        try:
            out["t3code"] = (
                sh(prefix + ["systemctl", "--user", "is-active", "--quiet", T3CODE_UNIT], timeout=10,
                   env=env).returncode == 0
                and sh(["pgrep", "-u", AGENT, "-x", "t3code"], timeout=5).returncode == 0)
        except (OSError, subprocess.SubprocessError):
            out["t3code"] = False
    port = int(state.get("viewer", {}).get("port", 8444))
    host = "127.0.0.1" if state.get("viewer", {}).get("listen") in ("0.0.0.0", "::", "127.0.0.1", None) \
        else state["viewer"]["listen"]
    try:
        with socket.create_connection((host, port), timeout=2):
            out["viewer"] = True
    except OSError:
        out["viewer"] = False
    if state.get("agentd", {}).get("installed"):
        listen = state["agentd"].get("listen", "127.0.0.1:8765")
        h, _, p = listen.rpartition(":")
        h = h.strip("[]")
        h = "127.0.0.1" if h in ("", "0.0.0.0") else h
        try:
            with urllib.request.urlopen(f"http://{h}:{p}/v1/health", timeout=3) as resp:
                out["agentd_health"] = resp.status == 200
        except (OSError, urllib.error.URLError, ValueError):
            out["agentd_health"] = False
    return out


def wait_ready(run: Run, timeout: float) -> int:
    deadline = time.monotonic() + timeout
    optional_deadline = None
    state = read_json(STATE)
    result: dict = {}
    while True:
        try:
            result = checks(state)
        except Exception as exc:  # keep polling; report at the deadline
            result = {"checks": False}
            run.warn(f"readiness check failed: {exc!r}")
        ok = all(v for k, v in result.items() if k not in OPTIONAL_CHECKS)
        if ok and all(result.values()):
            break
        if ok:
            # optional apps (T3 Code) get a short grace period once the desktop is up
            optional_deadline = optional_deadline or time.monotonic() + 30
            if time.monotonic() > optional_deadline:
                break
        if time.monotonic() > deadline:
            break
        time.sleep(2)
    state = read_json(STATE) or state
    state["checks"] = result
    state["ready_uptime"] = round(uptime_s(), 2)
    for name in OPTIONAL_CHECKS:
        if result.get(name) is False:
            state.setdefault("warnings", []).append(
                f"{name}: not running (journalctl --user -u agos-{name} as agent)")
    if not ok:
        failed = [k for k, v in result.items() if not v and k not in OPTIONAL_CHECKS]
        state.setdefault("errors", []).append(f"desktop not ready after {int(timeout)}s: {', '.join(failed)}")
    # Spec: "ready" or "error" (+ "message"); "starting" only while waiting.
    if ok and not state.get("errors"):
        state["state"] = "ready"
        state.pop("message", None)
    else:
        state["state"] = "error"
        state["message"] = "; ".join(state.get("errors", []))[:500]
    write_state(state)
    render_issue(state)
    run.log(f"state {state['state']} at {state['ready_uptime']}s after boot ({json.dumps(result)})")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--wait-ready", action="store_true",
                    help="wait for the desktop stack and mark state.json ready/degraded")
    ap.add_argument("--timeout", type=float, default=300, help="--wait-ready timeout (seconds)")
    args = ap.parse_args()
    if os.geteuid() != 0:
        print("agos-firstboot: must run as root", file=sys.stderr)
        return 1
    run = Run()
    if args.wait_ready:
        return wait_ready(run, args.timeout)
    try:
        return apply(run)
    except Exception as exc:  # last resort: record and never fail the boot
        run.error(f"unexpected: {exc!r}")
        try:
            state = read_json(STATE)
            state.update({"state": "error", "errors": run.errors, "message": "; ".join(run.errors)[:500]})
            write_state(state)
        except OSError:
            pass
        return 0


if __name__ == "__main__":
    sys.exit(main())
