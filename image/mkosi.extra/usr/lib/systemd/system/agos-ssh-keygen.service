# SSH host keys are removed from the image so clones never share them.
# cloud-init normally creates them; this covers boots without a datasource.
[Unit]
Description=agos: generate SSH host keys if missing
After=cloud-init-network.service cloud-init.service
Before=ssh.service ssh.socket
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=multi-user.target
RequiredBy=ssh.service
