# Pinned third-party inputs for the agos image. Sourced by scripts/sync.sh.
# Update deliberately: bump the version, fetch, verify, then update the hash.

# KasmVNC 1.5.0 (https://github.com/kasmtech/KasmVNC/releases/tag/v1.5.0).
# sha256 values match the "digest" field GitHub publishes for each asset.
KASMVNC_VERSION=1.5.0
KASMVNC_URL_BASE=https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0
KASMVNC_SHA256_amd64=80b241de7dfe53bba2b7e1cc5ac8c5246d72271efa16be2d4f76607f30fab1c4
KASMVNC_SHA256_arm64=fbb11589958a2acccd2d67f67944be79ac1e8e3a1d6172c0e6db6dc59e55a919

# Tailscale stable apt repository for Debian trixie.
TAILSCALE_KEYRING_URL=https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg
TAILSCALE_KEYRING_SHA256=3e03dacf222698c60b8e2f990b809ca1b3e104de127767864284e6c228f1fb39
TAILSCALE_KEYRING_FPR=2596A99EAAB33821893C0A79458CA832957F5868

# T3 Code desktop app (https://github.com/pingdotgg/t3code/releases/tag/v0.0.45):
# the Linux AppImage per architecture, unpacked at build time to /opt/t3code.
# sha256 values match the "digest" field GitHub publishes for each asset (the
# release's SHA256SUMS only lists the `t3` CLI tarballs); the sha512 in the
# release's latest-linux.yml / latest-linux-arm64.yml matches as well.
T3CODE_VERSION=0.0.45
T3CODE_URL_BASE=https://github.com/pingdotgg/t3code/releases/download/v0.0.45
T3CODE_SHA256_amd64=ab7b0a86d1ea657ccc162b60b772c61f70bc7c8b9e259b46939d53bb38faa02a
T3CODE_SHA256_arm64=03113566f52b07a4d503239c378540175691d9a057ed41e0e794897d6be054d5

# Claude Code signed apt repository (stable channel), per
# https://code.claude.com/docs/en/setup#install-with-linux-package-managers
CLAUDE_CODE_KEY_URL=https://downloads.claude.ai/keys/claude-code.asc
CLAUDE_CODE_KEY_SHA256=bd70a5e4a268002704024ceba7f8446024114e94f3f0bdd11c23a9e592be81c6
